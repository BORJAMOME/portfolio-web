+// Web build: skip files whose lower-case path ends with one of the
+// comma-separated suffixes in the IE_SKIP environment variable
+static bool skipped_by_suffix(const std::string & internal_path) {
+	const char * env = std::getenv("IE_SKIP");
+	if(!env || !*env) {
+		return false;
+	}
+	std::string list(env);
+	size_t start = 0;
+	while(start <= list.size()) {
+		size_t end = list.find(',', start);
+		if(end == std::string::npos) {
+			end = list.size();
+		}
+		std::string suffix = list.substr(start, end - start);
+		if(!suffix.empty() && internal_path.size() >= suffix.size()
+		   && internal_path.compare(internal_path.size() - suffix.size(), suffix.size(), suffix) == 0) {
+			return true;
+		}
+		start = end + 1;
+	}
+	return false;
+}
