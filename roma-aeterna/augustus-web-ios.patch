diff --git a/src/platform/SDL2/augustus.c b/src/platform/SDL2/augustus.c
index bffc244..8ff6c70 100644
--- a/src/platform/SDL2/augustus.c
+++ b/src/platform/SDL2/augustus.c
@@ -149,6 +149,34 @@ static void platform_per_frame_callback(void)
 }
 #endif
 
+
+#ifdef __EMSCRIPTEN__
+#include "building/construction.h"
+#include "city/view.h"
+#include "graphics/screen.h"
+
+/* Puente para la capa táctil de la web: la página pregunta qué ventana hay abierta
+   y dónde está el mapa para decidir si un toque es de mapa o de interfaz. */
+EMSCRIPTEN_KEEPALIVE int ra_window_id(void) { return window_get_id(); }
+EMSCRIPTEN_KEEPALIVE int ra_is_city(void) { return window_is(WINDOW_CITY) || window_is(WINDOW_CITY_MILITARY); }
+EMSCRIPTEN_KEEPALIVE int ra_screen_w(void) { return screen_width(); }
+EMSCRIPTEN_KEEPALIVE int ra_screen_h(void) { return screen_height(); }
+EMSCRIPTEN_KEEPALIVE int ra_view(int which)
+{
+    int x, y, w, h;
+    city_view_get_viewport(&x, &y, &w, &h);
+    return which == 0 ? x : which == 1 ? y : which == 2 ? w : h;
+}
+EMSCRIPTEN_KEEPALIVE int ra_constructing(void) { return building_construction_type() != 0; }
+EMSCRIPTEN_KEEPALIVE int ra_sidebar_collapsed(void) { return city_view_is_sidebar_collapsed(); }
+EMSCRIPTEN_KEEPALIVE void ra_toggle_sidebar(void)
+{
+    if (window_is(WINDOW_CITY)) {
+        city_view_start_sidebar_toggle();
+    }
+}
+#endif
+
 static void run_and_draw(void)
 {
     time_millis time_before_run = system_get_ticks();
